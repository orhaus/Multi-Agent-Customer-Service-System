# Copy to .env and fill in. .env is gitignored; this file is the contract.
#   cp .env.example .env

# Required. Create a free key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Router just classifies intent, so the fastest, cheapest model is enough.
# The agents do the reasoning the customer actually sees.
# Both are on the Gemini API free tier: https://ai.google.dev/gemini-api/docs/pricing
ROUTER_MODEL=gemini-3.5-flash-lite
AGENT_MODEL=gemini-3.8-flash

# Below this router confidence (0.0-1.0), escalate instead of guessing.
ROUTER_CONFIDENCE_THRESHOLD=0.7

# Turns an agent may spend before handing off to a human.
MAX_AGENT_TURNS=6

LOG_LEVEL=INFO
